-- (Query 1) Receita, leads, conversão e ticket médio mês a mês
-- Colunas: mês, leads (#), vendas (#), receita (k, R$), conversão (%), ticket médio (k, R$)

with info_visita_conversao as (
select
	date_trunc('month', visit_page_date)::date as mes, 
	count(visit_id) as leads
from sales.funnel 
group by mes
order by mes
),
info_receita as (
select 
	date_trunc('month', f.paid_date)::date as mes,
	sum(p.price*(1 + f.discount))/1000 as receita,
	count(f.paid_date) as vendas
from sales.funnel as f
left join sales.products as p
	on f.product_id = p.product_id
where f.paid_date is not null
group by mes
order by mes
)
select 
	c.mes as mes,
	c.leads as visitas,
	r.vendas as vendas, 
	r.receita as receita,
	r.vendas::float/c.leads::float as conversao, 
	r.receita/r.vendas as ticket_medio
from info_visita_conversao as c left join info_receita as r on c.mes = r.mes;


-- (Query 2) Estados que mais venderam
-- Colunas: país, estado, vendas (#)
select 
	'Brasil' as pais,
	c.state as estado, 
	count(f.paid_date) as vendas
from sales.funnel as f
left join sales.customers as c
	on f.customer_id = c.customer_id
group by c.state
order by vendas desc;

-- (Query 3) Marcas que mais venderam no mês
-- Colunas: marca, vendas (#)
select
	date_trunc('month', f.paid_date)::date as mes,
	p.brand as marca, 
	count(f.paid_date) as vendas
from sales.funnel as f
left join sales.products as p
	on f.product_id = p.product_id
where f.paid_date is not null
group by mes, marca
order by mes, vendas desc;

-- (Query 4) Lojas que mais venderam
-- Colunas: loja, vendas (#)
select 
	st.store_name as loja, 
	count(f.paid_date) as vendas
from sales.funnel as f
left join sales.stores as st
	on f.store_id = st.store_id
--where paid_date between '2021-08-01' and '2021-08-31'
group by st.store_id, loja
order by vendas desc;

